# Required
PORT=3000
STORAGE_PATH=/srv/latex-node

# Optional: IDs that own STORAGE_PATH on the host
PUID=1001
PGID=1001

# Optional tuning/overrides
PREVIEW_CONCURRENCY=2
LATEX_CLOUD_URL=https://latex.gg
# Recommended after configuring your public reverse-proxy origin
# NEXTAUTH_URL=https://files.example.com
# Comma-separated exact file/directory names hidden from imports
NODE_BROWSE_IGNORE_NAMES=.latex,.ssh,.gnupg,.aws,.kube,.docker,.env
# POSTGRES_PASSWORD=replace-with-a-random-internal-password
# LATEX_NODE_IMAGE=ghcr.io/tangles-0/latex-node:latest
# LATEX_PREVIEW_IMAGE=ghcr.io/tangles-0/latex-preview-gen:latest
